<?xml version="1.0" encoding="utf-8"?>
<!-- A field of the page's study modal: paper fill inside a hairline, 9dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cortex_page_background" />
    <stroke
        android:width="1dp"
        android:color="@color/cortex_line" />
    <corners android:radius="9dp" />
</shape>
