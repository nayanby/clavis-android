<?xml version="1.0" encoding="utf-8"?>
<!-- The note's own level-1 heading: a plum band with a deeper plum side bar at
     its left, the way the reader paints it. The bottom bar borrows it verbatim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cortex_note_burgundy" />
        </shape>
    </item>
    <item android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cortex_poster_secondary" />
        </shape>
    </item>
</layer-list>
