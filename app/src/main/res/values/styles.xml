<resources>
    <style name="Theme.Clavis" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowAnimationStyle">@style/ClavisScreenMotion</item><item name="android:fontFamily">@font/averia_serif_libre</item><item name="android:colorAccent">@color/control_accent</item><item name="android:colorControlActivated">@color/control_accent</item>
        <item name="android:windowBackground">#20272A</item><item name="android:colorBackground">#20272A</item><item name="android:statusBarColor">#20272A</item>
        <item name="android:navigationBarColor">#20272A</item><item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Clavis.Dialog</item>
        <item name="android:popupMenuStyle">@style/Widget.Clavis.Popup</item>
    </style>
    <style name="Theme.Clavis.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/ClavisScreenMotion</item><item name="android:fontFamily">@font/averia_serif_libre</item><item name="android:colorAccent">@color/control_accent</item><item name="android:colorControlActivated">@color/control_accent</item><item name="android:windowBackground">#EDF2F3</item><item name="android:colorBackground">#EDF2F3</item><item name="android:statusBarColor">#EDF2F3</item><item name="android:navigationBarColor">#EDF2F3</item><item name="android:windowLightStatusBar">true</item><item name="android:alertDialogTheme">@style/Theme.Clavis.Dialog.Light</item><item name="android:popupMenuStyle">@style/Widget.Clavis.Popup</item>
    </style>
    <style name="Theme.Clavis.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_app_dialog</item><item name="android:colorBackground">@color/card_background</item><item name="android:colorAccent">@color/control_accent</item><item name="android:colorControlActivated">@color/control_accent</item><item name="android:textColorPrimary">@color/ink</item><item name="android:textColorSecondary">@color/muted</item><item name="android:fontFamily">@font/averia_serif_libre</item><item name="android:buttonBarButtonStyle">@style/Widget.Clavis.DialogButton</item><item name="android:windowMinWidthMajor">86%</item><item name="android:windowMinWidthMinor">86%</item>
    </style>
    <style name="Theme.Clavis.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_app_dialog</item><item name="android:colorBackground">@color/card_background</item><item name="android:colorAccent">@color/control_accent</item><item name="android:colorControlActivated">@color/control_accent</item><item name="android:textColorPrimary">@color/ink</item><item name="android:textColorSecondary">@color/muted</item><item name="android:fontFamily">@font/averia_serif_libre</item><item name="android:buttonBarButtonStyle">@style/Widget.Clavis.DialogButton</item><item name="android:windowMinWidthMajor">86%</item><item name="android:windowMinWidthMinor">86%</item>
    </style>
    <style name="Widget.Clavis.Popup" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_app_dialog</item><item name="android:popupElevation">10dp</item>
    </style>
<style name="Widget.Clavis.DialogButton" parent="android:style/Widget.Material.Button.Borderless"><item name="android:textColor">@color/dialog_action_text</item><item name="android:fontFamily">@font/averia_serif_libre</item><item name="android:minHeight">48dp</item></style></resources>
